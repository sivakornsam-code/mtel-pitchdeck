VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Required in Vercel to protect the scheduled keep-alive endpoint
CRON_SECRET=replace_with_a_long_random_value

# Optional server-only aliases for the keep-alive endpoint. If omitted, the
# endpoint uses the VITE_SUPABASE_* variables above.
# SUPABASE_URL=your_supabase_project_url
# SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional: set to your deployed domain so copy-link uses the right base URL
# VITE_APP_URL=https://pitch.mtel.com
